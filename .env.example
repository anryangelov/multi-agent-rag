# Copy to .env and fill in only what you use. With no .env the system runs
# offline: LLM_PROVIDER=offline and EMBEDDING_PROVIDER=local.

LLM_PROVIDER=offline          # offline | anthropic | azure
EMBEDDING_PROVIDER=local      # local | azure

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
